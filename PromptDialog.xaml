<Window x:Class="FileExplorer.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent"
        Foreground="{DynamicResource cFFE8EEF6}" FontFamily="{DynamicResource UiFont}" FontSize="12">
  <Grid x:Name="Root" Background="{DynamicResource cB30A0D13}">
    <StackPanel Margin="18,16,18,14">
      <TextBlock x:Name="Label" Foreground="{DynamicResource cFF8A97AA}" Margin="2,0,0,8"/>
      <Border Background="{DynamicResource c12FFFFFF}" CornerRadius="{DynamicResource r6}" Padding="10,7" BorderBrush="{DynamicResource e2EFFFFFF}" BorderThickness="1">
        <TextBox x:Name="Input" Style="{StaticResource Bare}" FontSize="13" KeyDown="Input_KeyDown"/>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Cancel" Style="{StaticResource Tab}" Padding="14,6" Margin="0,0,6,0" Click="Cancel_Click"/>
        <Button x:Name="OkButton" Style="{StaticResource Tab}" Tag="on" Padding="16,6" Click="Ok_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
