<UserControl x:Class="FileExplorer.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- the chevrons between path segments: a Ghost button with less room around the glyph -->
    <Style x:Key="Chevron" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="3,5">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="NameCell">
      <StackPanel Orientation="Horizontal">
        <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource CutDim}">
          <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding IconBrush}" VerticalAlignment="Center" Opacity="0.9">
            <TextBlock.Visibility><Binding Path="NoSmallIcon"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility>
          </TextBlock>
          <Image Source="{Binding SmallIcon}" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image Source="{Binding Overlay}" RenderOptions.BitmapScalingMode="HighQuality"/> <!-- sync badge (Google Drive, Nextcloud, ...) -->
        </Grid>
        <Grid>
          <!-- not hit-testable: a right-click landing on one of its Runs made the list drop a multi-selection -->
          <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Visibility><Binding Path="NotRenaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Where, Mode=OneWay}" Foreground="#70FFFFFF" FontSize="11"/></TextBlock>
          <Border Background="#F2151A22" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="3" Padding="4,1" Margin="-4,-1,0,-1">
            <Border.Visibility><Binding Path="Renaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Border.Visibility>
            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Bare}" Foreground="#FFFFFF" FontWeight="SemiBold"
                     SelectionBrush="{DynamicResource Accent}" SelectionOpacity="0.85" SelectionTextBrush="White" IsInactiveSelectionHighlightEnabled="True"
                     Loaded="Rename_Loaded" KeyDown="Rename_KeyDown" LostKeyboardFocus="Rename_Done" Tag="{Binding}"/>
          </Border>
        </Grid>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="SizeCell">
      <TextBlock Text="{Binding SizeText}" Foreground="#B3FFFFFF" Typography.NumeralAlignment="Tabular" TextAlignment="Right" Margin="0,0,6,0"/>
    </DataTemplate>
    <DataTemplate x:Key="DateCell">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding FullDate}">
        <Border Background="{Binding AgeBrush}" CornerRadius="3" Width="36" Margin="0,0,8,0">
          <TextBlock Text="{Binding Age}" Foreground="{Binding AgeTextBrush}" FontSize="11" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        </Border>
        <TextBlock Text="{Binding DateText}" Foreground="#99FFFFFF" Typography.NumeralAlignment="Tabular"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TileCell">
      <StackPanel ToolTip="{Binding FullDate}">
        <Grid Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListView}}"
              Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListView}}" HorizontalAlignment="Center" Style="{StaticResource CutDim}">
          <!-- either the shell thumbnail or, until it arrives, a dim placeholder glyph — never both -->
          <Viewbox Margin="16" Opacity="0.35">
            <Viewbox.Visibility>
              <Binding Path="NoThumb"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
            </Viewbox.Visibility>
            <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding IconBrush}"/>
          </Viewbox>
          <Image Source="{Binding Thumb}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image Source="{Binding Overlay}" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
        <Border Height="3" Width="26" CornerRadius="1.5" Background="{Binding AgeBrush}" Margin="0,4,0,3" HorizontalAlignment="Center"/>
        <Grid>
          <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" FontSize="11.5"><TextBlock.Visibility><Binding Path="NotRenaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility></TextBlock>
          <Border Background="#F2151A22" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="3" Padding="4,1" Margin="-4,-1,0,-1">
            <Border.Visibility><Binding Path="Renaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Border.Visibility>
            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Bare}" Foreground="#FFFFFF" FontWeight="SemiBold"
                     SelectionBrush="{DynamicResource Accent}" SelectionOpacity="0.85" SelectionTextBrush="White" IsInactiveSelectionHighlightEnabled="True"
                     Loaded="Rename_Loaded" KeyDown="Rename_KeyDown" LostKeyboardFocus="Rename_Done" Tag="{Binding}"/>
          </Border>
        </Grid>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ListCell">
      <DockPanel Width="230" ToolTip="{Binding FullDate}">
        <Border DockPanel.Dock="Left" Width="3" Margin="0,1,6,1" CornerRadius="1.5" Background="{Binding AgeBrush}"/>
        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource CutDim}">
          <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding IconBrush}" VerticalAlignment="Center" Opacity="0.9">
            <TextBlock.Visibility><Binding Path="NoSmallIcon"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility>
          </TextBlock>
          <Image Source="{Binding SmallIcon}" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image Source="{Binding Overlay}" RenderOptions.BitmapScalingMode="HighQuality"/> <!-- sync badge (Google Drive, Nextcloud, ...) -->
        </Grid>
        <Grid>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><TextBlock.Visibility><Binding Path="NotRenaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility></TextBlock>
          <Border Background="#F2151A22" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="3" Padding="4,1" Margin="-4,-1,0,-1">
            <Border.Visibility><Binding Path="Renaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Border.Visibility>
            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Bare}" Foreground="#FFFFFF" FontWeight="SemiBold"
                     SelectionBrush="{DynamicResource Accent}" SelectionOpacity="0.85" SelectionTextBrush="White" IsInactiveSelectionHighlightEnabled="True"
                     Loaded="Rename_Loaded" KeyDown="Rename_KeyDown" LostKeyboardFocus="Rename_Done" Tag="{Binding}"/>
          </Border>
        </Grid>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Border x:Name="Card" Background="#0DFFFFFF" CornerRadius="10" BorderThickness="1" BorderBrush="#1AFFFFFF">
    <DockPanel>
      <!-- Tabs -->
      <!-- tabs share the row equally (browser-style): full width until they don't fit, then all shrink -->
      <!-- The dark strip is painted by everything AROUND the active tab (left edge, inactive tabs, the
           + area, the rest of the row). The active tab paints nothing, so it is exactly the panel's
           own surface and flows into the path bar below — no colour to keep in sync. -->
      <Grid DockPanel.Dock="Top">
      <!-- one shape for the whole strip, with the active tab's silhouette cut out of it: rounded
           top corners flaring outwards at the bottom, the way a browser (and FilePilot) draws tabs.
           The cut-out shows the panel's own surface, so the active tab always matches it exactly. -->
      <Path x:Name="StripShape" Fill="{StaticResource TabStripBg}"/>
      <DockPanel x:Name="TabBand" AllowDrop="True" Background="Transparent" SizeChanged="TabBand_SizeChanged" DragOver="Tabs_DragOver" DragLeave="Tabs_DragLeave" Drop="Tabs_Drop">
        <Border DockPanel.Dock="Left" Width="4"/>
        <UniformGrid x:Name="TabStrip" DockPanel.Dock="Left" Rows="1"/>
        <Border x:Name="NewTabBox" DockPanel.Dock="Left" Padding="4,4,4,2">
          <Button x:Name="NewTabButton" Style="{StaticResource Ghost}" Content="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11"
                  ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" VerticalAlignment="Center"/>
        </Border>
        <Border/>
      </DockPanel>
      <!-- where a dragged tab would land; an overlay, so the tabs never move under the pointer -->
      <Canvas IsHitTestVisible="False">
        <Border x:Name="TabDropLine" Width="3" CornerRadius="1.5" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
      </Canvas>
      </Grid>

      <!-- Path: breadcrumbs, editable on click in empty area / Ctrl+L -->
      <DockPanel DockPanel.Dock="Top" Margin="8,4,8,0">
        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="10" ToolTip="Back (Alt+Left)" Click="Back_Click"/>
        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="10" ToolTip="Forward (Alt+Right)" Click="Fwd_Click"/>
        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="10" ToolTip="Up (Backspace)" Click="Up_Click"/>
        <Border DockPanel.Dock="Right" Width="170" Background="#12FFFFFF" CornerRadius="5" Margin="6,0,0,0"
                ToolTip="Typing filters this folder. Enter searches every subfolder. * and ? work as wildcards.">
          <Grid>
            <TextBlock x:Name="FilterHint" Text="Filter · Enter searches" Foreground="#66FFFFFF" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="FilterBox" Style="{StaticResource Bare}" Margin="6,3" TextChanged="Filter_Changed"/>
          </Grid>
        </Border>
        <Grid>
          <Border Background="Transparent" MouseLeftButtonDown="Crumbs_Click">
            <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
          </Border>
          <TextBox x:Name="PathBox" Style="{StaticResource Bare}" Visibility="Collapsed" Margin="4,3"
                   PreviewKeyDown="PathBox_PreviewKeyDown" TextChanged="PathBox_Changed" LostKeyboardFocus="PathBox_Lost"/>
          <!-- folder suggestions while typing a path -->
          <Popup x:Name="Suggest" PlacementTarget="{Binding ElementName=PathBox}" Placement="Bottom" AllowsTransparency="True" StaysOpen="True">
            <Border Background="#F2161B24" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="6" Padding="3"
                    MinWidth="{Binding ActualWidth, ElementName=PathBox}">
              <ListBox x:Name="SuggestList" Focusable="False" Background="Transparent" BorderThickness="0" Foreground="#E8EEF6"
                       MaxHeight="320" PreviewMouseLeftButtonDown="Suggest_MouseDown">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Bd" Padding="8,4" CornerRadius="4" Background="Transparent"><ContentPresenter/></Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelect}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </Border>
          </Popup>
        </Grid>
      </DockPanel>

      <!-- Drive usage -->
      <DockPanel DockPanel.Dock="Top" Margin="14,6,14,4">
        <TextBlock x:Name="DriveInfoText" DockPanel.Dock="Right" Foreground="#80FFFFFF" FontSize="11" Margin="10,0,0,0"
                   Typography.NumeralAlignment="Tabular"/>
        <Grid VerticalAlignment="Center" Height="3">
          <Border Background="#1AFFFFFF" CornerRadius="1.5"/>
          <Border x:Name="UsedBar" Background="{DynamicResource Accent}" CornerRadius="1.5" HorizontalAlignment="Left"/>
        </Grid>
      </DockPanel>

      <DockPanel DockPanel.Dock="Bottom" Margin="14,2,8,5">
        <!-- sorting, reachable in every view mode (the column headers only exist in Details) -->
        <Button x:Name="SortButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" FontSize="11" Click="SortButton_Click" ToolTip="Sort">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="SortIcon" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,1,6,0"/>
            <TextBlock x:Name="SortName"/>
          </StackPanel>
        </Button>
        <Button x:Name="ViewButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" FontSize="11" Click="ViewButton_Click" ToolTip="View (Ctrl+Shift+1…5)">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ViewIcon" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,1,6,0"/>
            <TextBlock x:Name="ViewName"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="Footer" Foreground="#80FFFFFF" FontSize="11" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
      </DockPanel>

      <Grid>
      <!-- drag-to-select rectangle, drawn over the list so the rows never move under it -->
      <Canvas Panel.ZIndex="1" IsHitTestVisible="False" Margin="4,0" ClipToBounds="True">
        <Border x:Name="Marquee" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentEdge}" BorderThickness="1" CornerRadius="2" Visibility="Collapsed"/>
      </Canvas>
      <!-- ScrollUnit=Pixel keeps virtualization but scrolls smoothly instead of jumping a row at a time -->
      <ListView x:Name="List" Background="Transparent" BorderThickness="0" Margin="4,0"
                TextSearch.TextPath="Name" VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
          <GridView>
            <GridViewColumn x:Name="NameColumn" Header="Name" Width="200" CellTemplate="{StaticResource NameCell}"/>
            <GridViewColumn Header="Version" Width="80">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Version}" Foreground="#8A97AA" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Type" Width="50">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Ext}" Foreground="#8A97AA"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Size" Width="80" CellTemplate="{StaticResource SizeCell}"/>
            <GridViewColumn Header="Modified" Width="170" CellTemplate="{StaticResource DateCell}"/>
          </GridView>
        </ListView.View>
      </ListView>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
