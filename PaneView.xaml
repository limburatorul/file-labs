<UserControl x:Class="FileExplorer.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="Card" Background="#0DFFFFFF" CornerRadius="10" BorderThickness="1" BorderBrush="#1AFFFFFF">
    <DockPanel>
      <!-- Tabs -->
      <!-- tabs share the row equally (browser-style): full width until they don't fit, then all shrink -->
      <!-- The dark strip is painted by everything AROUND the active tab (left edge, inactive tabs, the
           + area, the rest of the row). The active tab paints nothing, so it is exactly the panel's
           own surface and flows into the path bar below — no colour to keep in sync. -->
      <DockPanel x:Name="TabBand" DockPanel.Dock="Top" SizeChanged="TabBand_SizeChanged">
        <Border DockPanel.Dock="Left" Width="4" Background="{StaticResource TabStripBg}" CornerRadius="9,0,0,0"/>
        <UniformGrid x:Name="TabStrip" DockPanel.Dock="Left" Rows="1"/>
        <Border x:Name="NewTabBox" DockPanel.Dock="Left" Background="{StaticResource TabStripBg}" Padding="4,4,4,2">
          <Button x:Name="NewTabButton" Style="{StaticResource Ghost}" Content="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11"
                  ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" VerticalAlignment="Center"/>
        </Border>
        <Border Background="{StaticResource TabStripBg}" CornerRadius="0,9,0,0"/>
      </DockPanel>

      <!-- Path: breadcrumbs, editable on click in empty area / Ctrl+L -->
      <DockPanel DockPanel.Dock="Top" Margin="8,4,8,0">
        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="10" ToolTip="Back (Alt+Left)" Click="Back_Click"/>
        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="10" ToolTip="Forward (Alt+Right)" Click="Fwd_Click"/>
        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="10" ToolTip="Up (Backspace)" Click="Up_Click"/>
        <Border DockPanel.Dock="Right" Width="150" Background="#12FFFFFF" CornerRadius="5" Margin="6,0,0,0">
          <Grid>
            <TextBlock x:Name="FilterHint" Text="Filter  (Ctrl+F)" Foreground="#66FFFFFF" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="FilterBox" Style="{StaticResource Bare}" Margin="6,3" TextChanged="Filter_Changed"/>
          </Grid>
        </Border>
        <Grid>
          <Border Background="Transparent" MouseLeftButtonDown="Crumbs_Click">
            <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
          </Border>
          <TextBox x:Name="PathBox" Style="{StaticResource Bare}" Visibility="Collapsed" Margin="4,3"
                   KeyDown="PathBox_KeyDown" LostKeyboardFocus="PathBox_Lost"/>
        </Grid>
      </DockPanel>

      <!-- Drive usage -->
      <DockPanel DockPanel.Dock="Top" Margin="14,6,14,4">
        <TextBlock x:Name="DriveInfoText" DockPanel.Dock="Right" Foreground="#80FFFFFF" FontSize="11" Margin="10,0,0,0"
                   Typography.NumeralAlignment="Tabular"/>
        <Grid VerticalAlignment="Center" Height="3">
          <Border Background="#1AFFFFFF" CornerRadius="1.5"/>
          <Border x:Name="UsedBar" Background="{StaticResource Accent}" CornerRadius="1.5" HorizontalAlignment="Left"/>
        </Grid>
      </DockPanel>

      <DockPanel DockPanel.Dock="Bottom" Margin="14,2,8,5">
        <Button x:Name="ViewButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" FontSize="11" Click="ViewButton_Click" ToolTip="View (Ctrl+Shift+1…5)">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ViewIcon" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,1,6,0"/>
            <TextBlock x:Name="ViewName"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="Footer" Foreground="#80FFFFFF" FontSize="11" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
      </DockPanel>

      <ListView x:Name="List" Background="Transparent" BorderThickness="0" Margin="4,0"
                TextSearch.TextPath="Name" VirtualizingPanel.IsVirtualizing="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
          <GridView>
            <GridViewColumn x:Name="NameColumn" Header="Name" Width="200" CellTemplate="{StaticResource NameCell}"/>
            <GridViewColumn Header="Version" Width="80">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Version}" Foreground="#8A97AA" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Type" Width="50">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Ext}" Foreground="#8A97AA"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Size" Width="80" CellTemplate="{StaticResource SizeCell}"/>
            <GridViewColumn Header="Modified" Width="170" CellTemplate="{StaticResource DateCell}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </DockPanel>
  </Border>
</UserControl>
