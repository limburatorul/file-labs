<Application x:Class="FileExplorer.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
    <!-- the accent at the three transparencies the UI needs; all four follow the colour chosen in Settings -->
    <SolidColorBrush x:Key="AccentEdge" Color="#A64C8DFF"/>
    <SolidColorBrush x:Key="AccentSelect" Color="#734C8DFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#454C8DFF"/>
    <SolidColorBrush x:Key="Muted" Color="#8CFFFFFF"/>
    <!-- the darker band tabs sit on -->
    <SolidColorBrush x:Key="TabStripBg" Color="#2E000000"/>
    <!-- ScrollViewer corner square and similar system fills: keep them see-through -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>

    <!-- Scrollbars per Branding: translucent white thumb 0.16 / 0.30 / 0.42, 6px visible -->
    <Style x:Key="Thumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="B" Background="#29FFFFFF" CornerRadius="3" Margin="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#4DFFFFFF"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="B" Property="Background" Value="#6BFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
              <Track.Thumb><Thumb Style="{StaticResource Thumb}"/></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Horizontal">
                  <Track.Thumb><Thumb Style="{StaticResource Thumb}"/></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="#E8EEF6"/>
      <Setter Property="Padding" Value="{DynamicResource RowPad}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <Grid>
                <GridViewRowPresenter/>
                <!-- age bar sits in the row padding so columns stay aligned with the headers -->
                <Border Width="3" CornerRadius="1.5" Background="{Binding AgeBrush}" HorizontalAlignment="Left" Margin="-3,1,0,1"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Dimmed}" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></DataTrigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#10FFFFFF"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelect}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Foreground" Value="#9AA6B8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <!-- flat header row: bottom rule, a thin separator on each column's right edge (also the resize grip) -->
            <Grid>
              <Border x:Name="Bd" Background="Transparent" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1" Padding="10,6,12,6" Cursor="Hand">
                <ContentPresenter HorizontalAlignment="Stretch"/>
              </Border>
              <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="9" Margin="0,0,-5,1" Cursor="SizeWE">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                      <Border x:Name="G" Width="1" Margin="0,6" Background="#2EFFFFFF" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="G" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="G" Property="Width" Value="2"/></Trigger>
                      <Trigger Property="IsDragging" Value="True"><Setter TargetName="G" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="G" Property="Width" Value="2"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                <Setter Property="Foreground" Value="#E8EEF6"/>
              </Trigger>
              <!-- filler after the last column: just the bottom rule -->
              <Trigger Property="Role" Value="Padding">
                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="Bd" Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- icon of an item that has been cut (Ctrl+X): dimmed, like FilePilot -->
    <Style x:Key="CutDim" TargetType="FrameworkElement">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCut}" Value="True"><Setter Property="Opacity" Value="0.4"/></DataTrigger>
      </Style.Triggers>
    </Style>


    <!-- Icon / list views: size comes from the ListView's Tag (thumbnail edge in px) -->
    <Style x:Key="ListViewItem.Plain" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="#E8EEF6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="4,3" Margin="0,0,8,0">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Dimmed}" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></DataTrigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#10FFFFFF"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelect}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TileItem" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="#E8EEF6"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="6">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Dimmed}" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></DataTrigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#10FFFFFF"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelect}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarHeader" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#10FFFFFF"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#D0FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="7,4">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Side" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style x:Key="Tab" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Foreground" Value="#80FFFFFF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MaxWidth" Value="140"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="9,3" Margin="0,0,2,0">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#10FFFFFF"/></Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Foreground" Value="#F0FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BrowserTab" TargetType="Button">
      <Setter Property="Foreground" Value="#B4BECC"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <!-- the strip shape behind paints the tab; this only adds hover and the divider -->
              <Border x:Name="Bd" Background="Transparent" CornerRadius="8,8,0,0" Padding="9,7,6,7" Margin="0,4,0,0">
                <ContentPresenter/>
              </Border>
              <Border x:Name="Divider" Width="1" Margin="0,12,0,8" HorizontalAlignment="Right" Background="#2EFFFFFF"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                <Setter TargetName="Divider" Property="Visibility" Value="Hidden"/>
                <Setter Property="Foreground" Value="#F2F6FB"/>
              </Trigger>
              <Trigger Property="Uid" Value="beforeActive">
                <Setter TargetName="Divider" Property="Visibility" Value="Hidden"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TabClose" TargetType="Button">
      <Setter Property="Foreground" Value="#8A97AA"/>
      <Setter Property="Visibility" Value="Collapsed"/> <!-- takes no room when not shown, so narrow tabs keep their name -->
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4" Background="Transparent" Margin="6,0,0,0">
              <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="9" FontWeight="Normal" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <!-- the (x) shows on the active tab and on hover -->
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="on">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Bare" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F0FFFFFF"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <BooleanToVisibilityConverter x:Key="Vis"/>

    <!-- Thin progress bar: WPF fills PART_Indicator to Value/Maximum of PART_Track -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#1AFFFFFF" CornerRadius="2"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="18">
              <Border Height="3" CornerRadius="1.5" Background="#1AFFFFFF" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate><Border Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template><ControlTemplate><Ellipse Width="12" Height="12" Fill="#E8EEF6"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EEF6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent">
              <Border x:Name="Track" DockPanel.Dock="Left" Width="30" Height="16" CornerRadius="8" Background="#1FFFFFFF" Margin="0,0,10,0" VerticalAlignment="Center">
                <Ellipse x:Name="Knob" Width="10" Height="10" Fill="#8A97AA" HorizontalAlignment="Left" Margin="3,0"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#994C8DFF"/>
                <Setter TargetName="Track" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Menus stay opaque (Branding: menus on glass become unreadable) -->
    <!-- Context menu: opaque (menus on glass become unreadable), rounded, icon | text | shortcut -->
    <Style TargetType="ContextMenu">
      <Setter Property="Foreground" Value="#E8EEF6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HasDropShadow" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#1C2029" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="8" Padding="0,4" MinWidth="220" Margin="0,0,6,6">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45"/></Border.Effect>
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#E8EEF6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid>
              <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="4,0" Padding="8,5">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" TextElement.Foreground="#8A97AA"/>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#6E7A8C" Margin="28,0,0,0" VerticalAlignment="Center"/>
                  <!-- an item with children shows the usual arrow instead of a shortcut -->
                  <Path x:Name="Arrow" Grid.Column="2" Data="M0,0 L4,4 L0,8 Z" Fill="#8A97AA" Margin="28,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" HorizontalOffset="-6"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#1C2029" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="8" Padding="0,4" MinWidth="160" Margin="0,0,6,6">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45"/></Border.Effect>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelect}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
              <Trigger Property="HasItems" Value="True">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="12,4" Background="#1FFFFFFF"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
