<Window x:Class="FileExplorer.NewFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New file" Width="420" Height="460" MinWidth="340" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent"
        Foreground="#E8EEF6" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <Grid x:Name="Root" Background="#B30A0D13">
    <DockPanel Margin="16,14,16,14">
      <TextBlock DockPanel.Dock="Top" Text="File type" Foreground="#8A97AA" Margin="2,0,0,6"/>
      <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <Button DockPanel.Dock="Right" Content="Create" Style="{StaticResource Tab}" Tag="on" Padding="16,6" Click="Create_Click"/>
        <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Tab}" Padding="14,6" Margin="0,0,6,0" Click="Cancel_Click"/>
        <Border Background="#12FFFFFF" CornerRadius="6" Padding="8,5">
          <TextBox x:Name="NameBox" Style="{StaticResource Bare}" KeyDown="Name_KeyDown"/>
        </Border>
      </DockPanel>

      <ListBox x:Name="Types" Background="Transparent" BorderThickness="0" SelectionChanged="Type_Changed"
               MouseDoubleClick="Create_Click" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E8EEF6"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#10FFFFFF"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#404C8DFF"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Extension}" Foreground="#6E7A8C" Margin="10,0,0,0"/>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</Window>
