<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FileLabs</AssemblyName>
    <Product>File Labs</Product>
    <Company>Protagonist Labs</Company>
    <Version>1.0.8</Version>
    <!-- WPF windows without their own Icon use this one, so every window gets it -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;installer\**</DefaultItemExcludes>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>
</Project>
