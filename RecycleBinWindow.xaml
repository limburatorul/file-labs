<Window x:Class="FileExplorer.RecycleBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recycle Bin" Width="980" Height="620" WindowStartupLocation="CenterOwner" Background="Transparent"
        Foreground="#E8EEF6" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <Grid x:Name="Root" Background="#B30A0D13">
    <DockPanel Margin="14,12,14,12">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Tab}" MaxWidth="200" Padding="12,6" Margin="0,0,6,0" Click="Restore_Click" ToolTip="Put the selected items back where they were deleted from">
            <TextBlock><Run FontFamily="Segoe Fluent Icons" Text="&#xE777;"/>  Restore</TextBlock>
          </Button>
          <Button Style="{StaticResource Tab}" MaxWidth="200" Padding="12,6" Margin="0,0,6,0" Click="Delete_Click">
            <TextBlock><Run FontFamily="Segoe Fluent Icons" Text="&#xE74D;"/>  Delete permanently</TextBlock>
          </Button>
          <Button Style="{StaticResource Tab}" MaxWidth="200" Padding="12,6" Click="Empty_Click">
            <TextBlock><Run FontFamily="Segoe Fluent Icons" Text="&#xE894;"/>  Empty Recycle Bin</TextBlock>
          </Button>
        </StackPanel>
        <TextBlock x:Name="Summary" Foreground="#8A97AA" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="#8A97AA" FontSize="11" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"/>
      <Border Background="#0DFFFFFF" CornerRadius="10" BorderThickness="1" BorderBrush="#1AFFFFFF" Padding="4,2">
        <ListView x:Name="List" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="List_DoubleClick">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Name" Width="260">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="{Binding GlyphBrush}" Margin="0,1,8,0"/>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Deleted from" Width="380">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Folder}" Foreground="#8A97AA" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Deleted" Width="140">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding DeletedText}" Foreground="#99FFFFFF" Typography.NumeralAlignment="Tabular"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Size" Width="90">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding SizeText}" Foreground="#B3FFFFFF" Typography.NumeralAlignment="Tabular" TextAlignment="Right"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
    </DockPanel>
  </Grid>
</Window>
