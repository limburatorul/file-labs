<Window x:Class="FileExplorer.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update — File Labs" Width="520" Height="440" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Background="Transparent"
        Foreground="{DynamicResource cFFE8EEF6}" FontFamily="{DynamicResource UiFont}" FontSize="12">
  <Grid x:Name="Root" Background="{DynamicResource cB30A0D13}">
    <DockPanel Margin="18,16,18,14">
      <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold"/>
      <TextBlock x:Name="Sub" DockPanel.Dock="Top" Foreground="{DynamicResource cFF8A97AA}" Margin="0,4,0,12"/>

      <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <TextBlock x:Name="Status" Foreground="{DynamicResource cFF8A97AA}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="LaterButton" Content="Later" Style="{StaticResource Tab}" Padding="14,6" Margin="0,0,6,0" Click="Later_Click"/>
          <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource Tab}" Tag="on" Padding="16,6" Click="Update_Click"/>
        </StackPanel>
      </DockPanel>
      <ProgressBar x:Name="Progress" DockPanel.Dock="Bottom" Height="4" Maximum="1" Visibility="Collapsed" Margin="0,10,0,0"/>

      <Border Background="{DynamicResource c59000000}" CornerRadius="{DynamicResource r8}" Padding="2">
        <TextBox x:Name="Notes" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource cFFD6DEEA}" BorderThickness="0"
                 Padding="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </Border>
    </DockPanel>
  </Grid>
</Window>
